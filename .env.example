# Copiar a .env y rellenar. El .env no se sube: esta en el .gitignore.

TELEGRAM_TOKEN=

# El grupo y el tema donde publica.
#
# GRUPO_ID empieza por -100. El del tema es el message_thread_id, que se ve
# en el enlace de cualquier mensaje del tema: t.me/c/2345678901/12/345 ->
# el grupo es -1002345678901 y el tema es el 12 (el 345 es el mensaje).
GRUPO_ID=
TEMA_ID=

# Quien puede usar /estado, /descartes y /sondear. Varios con comas.
ADMIN_ID=

# Postgres. En Railway se pone con la referencia al servicio, no a mano.
DATABASE_URL=
# "require" en Railway. Con un Postgres en casa, "disable".
DB_SSL=require

# Lo ajustable. Los valores de fabrica estan en config.py y van bien:
# esto solo hace falta para cambiarlos sin desplegar.
# MINUTOS_SONDEO=15
# PAUSA_PUBLICACION=45
# UMBRAL_PARECIDO=0.6
# HORAS_PARECIDO=48
# TOPE_POR_FUENTE=15
